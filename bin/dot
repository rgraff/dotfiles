#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.
# Use DOTFILES_ROOT when run from script/bootstrap; otherwise default to ~/.dotfiles
export DOTHOME="${DOTFILES_ROOT:-$HOME/.dotfiles}"

DISTRO=$(uname)
case $DISTRO in
  'Linux')
    sudo apt-get update
    sudo apt-get -y -q upgrade
    ;;
  'Darwin')
    # Set OS X defaults
    sh "$DOTHOME/osx/set-defaults.sh"
    # Oh My Zsh (once)
    [ -f "$DOTHOME/zsh/install.sh" ] && { echo "Zsh/Oh My Zsh"; zsh "$DOTHOME/zsh/install.sh" 2>&1; }
    # Install/upgrade nodes
    sh "$DOTHOME/node/install.sh" 2>&1
    # Install/upgrade homebrew packages
    echo "Homebrew update"
    sh "$DOTHOME/homebrew/install.sh" 2>&1

    # Install/upgrade rubies
    echo "Ruby update"
    sh "$DOTHOME/ruby/install.sh" 2>&1
    [ -f "$DOTHOME/databases/install.sh" ] && { echo "Database(s) update"; sh "$DOTHOME/databases/install.sh" 2>&1; }
    ;;
  *)
    echo "Good luck with that"
    ;;
esac

# Install vim bundles (optional; runs on all platforms)
[ -f "$DOTHOME/vim/install.sh" ] && sh "$DOTHOME/vim/install.sh" 2>&1